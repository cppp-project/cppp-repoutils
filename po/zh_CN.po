#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:136
msgid "Success."
msgstr "成功。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:138
msgid "SQL error or missing database."
msgstr "SQL 错误或缺少数据库。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:140
msgid "Internal logic error in SQLite."
msgstr "SQLite 内部逻辑错误。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:142
msgid "Access permission denied."
msgstr "访问权限被拒绝。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:144
msgid "Callback routine requested an abort."
msgstr "回调例程请求中止。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:146
msgid "The database file is locked."
msgstr "数据库文件被锁定。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:148
msgid "A table in the database is locked."
msgstr "数据库中的一个表被锁定。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:150
msgid "Memory allocation/reallocation failed."
msgstr "内存分配/重新分配失败。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:152
msgid "Attempt to write a readonly database."
msgstr "尝试写入只读数据库。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:154
msgid "Operation terminated by sqlite3_interrupt()."
msgstr "操作被 sqlite3_interrupt() 终止。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:156
msgid "I/O error."
msgstr "输入/输出错误。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:158
msgid "The database file has been corrupted."
msgstr "数据库文件已损坏。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:160
msgid "Insertion failed because database is full."
msgstr "插入失败，因为数据库已满。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:162
msgid "Unable to open the database file."
msgstr "无法打开数据库文件。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:164
msgid "Database file is malformed."
msgstr "数据库文件格式错误。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:169
msgid "The database schema changed."
msgstr "数据库模式已更改。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:171
msgid "String or BLOB was too large."
msgstr "字符串或 BLOB 太大。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:173
msgid "Abort due to constraint violation."
msgstr "由于约束违规而中止。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:175
msgid "Data type mismatch."
msgstr "数据类型不匹配。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:177
msgid "Library used incorrectly."
msgstr "库使用不正确。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:179
msgid "No large file support."
msgstr "没有大文件支持。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:181
msgid "Illegal authorization request."
msgstr "非法的授权请求。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:186
msgid "2nd parameter to sqlite3_bind out of range."
msgstr "第二个参数超出范围。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:188
msgid "File opened that is not a database file."
msgstr "打开的文件不是数据库文件。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:190
msgid "Another row of output is available."
msgstr "另一行输出可用。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:192
msgid "An operation is completed."
msgstr "操作已完成。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:195
msgid "An SQL statement could not be prepared because a collating sequence named in that SQL statement could not be located."
msgstr "一个 SQL 语句无法准备，因为在该 SQL 语句中命名的排序序列无法找到。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:200
msgid "Operation could not continue because another process is busy recovering a WAL mode database file following a crash."
msgstr "由于另一个进程正在忙于恢复崩溃后的 WAL 模式数据库文件，操作无法继续。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:205
msgid "Access to an SQLite data record is blocked by another database connection that is using the same record in shared cache mode."
msgstr "另一个数据库连接正在使用共享缓存模式中的相同记录，阻止对 SQLite 数据记录的访问。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:211
msgid "A WAL mode database cannot be opened because the database file needs to be recovered and recovery requires write access but only read access is available."
msgstr "一个 WAL 模式数据库无法打开，因为数据库文件需要恢复，而恢复需要写访问权限，但只有读访问权限可用。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:217
msgid "Hardware malfunction or a filesystem came unmounted while the file was open."
msgstr "硬件故障或文件系统在文件打开时卸载。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:221
msgid "Content in the virtual table is corrupt."
msgstr "虚拟表中的内容损坏。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:226
msgid "A CHECK constraint failed."
msgstr "一个 CHECK 约束失败。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:229
msgid "An operation was attempted on a database for which the logged in user lacks sufficient authorization."
msgstr "尝试对一个数据库进行操作，但登录的用户缺乏足够的授权。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:233
msgid "A WAL mode database file has been recovered."
msgstr "一个 WAL 模式数据库文件已经恢复。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:236
msgid "An SQL statement aborted because the transaction that was active when the SQL statement first started was rolled back."
msgstr "一个 SQL 语句中止，因为在 SQL 语句首次启动时活动的事务被回滚。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:241
msgid "A WAL mode database connection tries to promote a read transaction into a write transaction but finds that another database connection has already written to the database and thus invalidated prior reads."
msgstr "一个 WAL 模式数据库连接试图将一个读事务提升为写事务，但发现另一个数据库连接已经写入了数据库，从而使之前的读取无效。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:248
msgid "Virtual table implementations cannot complete the current operation because of locks held by other threads or processes."
msgstr "由于其他线程或进程持有的锁，虚拟表实现无法完成当前操作。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:253
msgid "SQLite is unable to obtain a read lock on a WAL mode database because the shared-memory file associated with that database is read-only."
msgstr "由于与该数据库关联的共享内存文件是只读的，SQLite 无法在 WAL 模式数据库上获取读锁。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:259
msgid "A read attempt in the VFS layer was unable to obtain as many bytes as was requested."
msgstr "VFS 层的读取尝试无法获得所请求的字节数。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:263
msgid "The schema of the sqlite_sequence table is corrupt."
msgstr "sqlite_sequence 表的模式损坏。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:266
msgid "A file failed to open because the file is really a directory."
msgstr "文件打开失败，因为文件实际上是一个目录。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:270
msgid "A commit hook callback returned non-zero that thus caused the SQL statement to be rolled back."
msgstr "一个提交钩子回调返回了非零值，导致 SQL 语句被回滚。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:274
msgid "The historical snapshot is no longer available."
msgstr "历史快照不再可用。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:277
msgid "A blocking POSIX advisory file lock request in the VFS layer failed due to a timeout."
msgstr "一个在 VFS 层的阻塞 POSIX 咨询文件锁请求由于超时而失败。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:282
msgid "A database cannot be opened because it has a hot journal that needs to be rolled back but cannot because the database is readonly."
msgstr "数据库无法打开，因为它有一个需要回滚的热日志，但无法回滚，因为数据库是只读的。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:288
msgid "An I/O error occured in the VFS layer while trying to write into a file on disk."
msgstr "尝试在磁盘上的文件中写入时，VFS 层中发生了 I/O 错误。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:292
msgid "SQLite detected an entry is or was missing from an index."
msgstr "SQLite 检测到一个条目在索引中缺失或已缺失。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:295
msgid "A file open operation failed because the operating system was unable to convert the filename into a full pathname."
msgstr "文件打开操作失败，因为操作系统无法将文件名转换为完整路径名。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:299
msgid "A foreign key constraint failed."
msgstr "一个外键约束失败。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:302
msgid "A database cannot be modified because the database file has been moved since it was opened."
msgstr "数据库无法修改，因为数据库文件在打开后已经移动。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:307
#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:315
msgid "An I/O error occured in the VFS layer while trying to fsync."
msgstr "尝试 fsync 时发 VFS 层中的 I/O 错误。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:310
msgid "cygwin_conv_path() failed."
msgstr "cygwin_conv_path() 失败。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:312
msgid "A function constraint failed."
msgstr "一个函数约束失败。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:321
msgid "A NOT NULL constraint failed."
msgstr "一个 NOT NULL 约束失败。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:324
msgid "The database is read-only because process does not have permission to create a journal file in the same directory as the database and the creation of a journal file is a prerequisite for writing."
msgstr "数据库是只读的，因为进程没有权限在与数据库相同的目录中创建日志文件，而创建日志文件是写入的先决条件。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:331
msgid "I/O error in the VFS layer while trying to truncate a file to a smaller size."
msgstr "在尝试将文件截断为较小大小时，VFS 层中的 I/O 错误。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:336
msgid "SQLITE_OPEN_NOFOLLOW is used but the database file is a symlink."
msgstr "SQLITE_OPEN_NOFOLLOW 被使用，但数据库文件是一个符号链接。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:339
msgid "A PRIMARY KEY constraint failed."
msgstr "一个 PRIMARY KEY 约束失败。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:342
msgid "An I/O error occured in the VFS layer while trying to invoke fstat() (or the equivalent) on a file in order to determine information such as the file size or access permissions."
msgstr "尝试调用 fstat()（或等效函数）以确定文件大小或访问权限等信息时，VFS 层中发生了 I/O 错误。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:348
msgid "A RAISE function within a trigger fired, causing the SQL statement to abort."
msgstr "一个触发器中的 RAISE 函数触发，导致 SQL 语句中止。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:353
msgid "An I/O error within xUnlock method on the sqlite3_io_methods object."
msgstr "一个 sqlite3_io_methods 对象上的 xUnlock 方法中的 I/O 错误。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:357
msgid "A UNIQUE constraint failed."
msgstr "一个 UNIQUE 约束失败。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:360
msgid "I/O error within xLock method on the sqlite3_io_methods object while trying to obtain a read lock."
msgstr "在尝试获取读锁时，sqlite3_io_methods 对象上的 xLock 方法中发生 I/O 错误。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:364
msgid "I/O error within xDelete method on the sqlite3_vfs object."
msgstr "在 sqlite3_vfs 对象上的 xDelete 方法中发生 I/O 错误。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:366
msgid "A rowid is not unique."
msgstr "一个 rowid 不是唯一的。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:372
msgid "An UPDATE trigger attempted do delete the row that was being updated in the middle of the update."
msgstr "一个 UPDATE 触发器尝试在更新过程中删除正在更新的行。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:377
msgid "An operation could not be completed due to the inability to allocate sufficient memory."
msgstr "由于无法分配足够的内存，无法完成操作。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:382
msgid "I/O error occured within the xAccess method on the sqlite3_vfs object."
msgstr "在 sqlite3_vfs 对象上的 xAccess 方法中发生 I/O 错误。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:387
msgid "I/O error within the xCheckReservedLock method on the sqlite3_io_methods object."
msgstr "在 sqlite3_io_methods 对象上的 xCheckReservedLock 方法中发生 I/O 错误。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:391
msgid "I/O error in the advisory file locking logic."
msgstr "咨询文件锁定逻辑中的 I/O 错误。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:394
msgid "I/O error within the xClose method on the sqlite3_io_methods object."
msgstr "在 sqlite3_io_methods 对象上的 xClose 方法中发生 I/O 错误。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:402
msgid "I/O error within the xShmMap method on the sqlite3_io_methods object while trying to open a new shared memory segment."
msgstr "在尝试打开一个新的共享内存段时，sqlite3_io_methods 对象上的 xShmMap 方法中发生 I/O 错误。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:408
msgid "I/O error within the xShmMap method on the sqlite3_io_methods object while trying to enlarge a \"shm\" file as part of WAL mode transaction processing. This error may indicate that the underlying filesystem volume is out of space."
msgstr "在尝试在 WAL 模式事务处理的一部分中扩大 \"shm\" 文件时，sqlite3_io_methods 对象上的 xShmMap 方法中发生 I/O 错误。此错误可能表示底层文件系统卷空间不足。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:418
msgid "I/O error within the xShmMap method on the sqlite3_io_methods object while trying to map a shared memory segment into the process address space."
msgstr "在尝试将共享内存段映射到进程地址空间时，sqlite3_io_methods 对象上的 xShmMap 方法中发生 I/O 错误。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:424
msgid "I/O error within the xRead or xWrite methods on the sqlite3_io_methods object while trying to seek a file descriptor to the beginning point of the file where the read or write is to occur."
msgstr "在尝试将文件描述符定位到读取或写入的文件的起始点时，sqlite3_io_methods 对象上的 xRead 或 xWrite 方法中发生 I/O 错误。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:431
msgid "The xDelete method on the sqlite3_vfs object failed because the file being deleted does not exist."
msgstr "sqlite3_vfs 对象上的 xDelete 方法失败，因为要删除的文件不存在。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:436
msgid "I/O error within the xFetch or xUnfetch methods on the sqlite3_io_methods object while trying to map or unmap part of the database file into the process address space."
msgstr "在尝试将数据库文件的一部分映射或取消映射到进程地址空间时，sqlite3_io_methods 对象上的 xFetch 或 xUnfetch 方法中发生 I/O 错误。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:442
msgid "The VFS is unable to determine a suitable directory in which to place temporary files."
msgstr "VFS 无法确定一个合适的目录来放置临时文件。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:446
msgid "The cygwin_conv_path() system call failed."
msgstr "cygwin_conv_path() 系统调用失败。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:449
msgid "The underlying operating system reported and error on the SQLITE_FCNTL_BEGIN_ATOMIC_WRITE file-control."
msgstr "操作系统在 SQLITE_FCNTL_BEGIN_ATOMIC_WRITE 文件控制上报告了错误。"

#: /workspaces/cppp/rubisco/rubisco/lib/sqlite_strerror.py:454
